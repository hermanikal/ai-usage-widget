# Required. Generate with: openssl rand -hex 32
AI_USAGE_API_KEY=replace-with-a-long-random-secret

# Safe default: the API is local-only. Use 0.0.0.0 only behind Tailscale,
# a VPN, or a reverse proxy with TLS and access controls.
AI_USAGE_BIND_HOST=127.0.0.1
AI_USAGE_PORT=8787

# Optional: command that prints one ChatGPT snapshot as JSON to stdout.
# The command is executed locally without a shell. Example schema is in
# examples/chatgpt-snapshot.example.json.
# CHATGPT_USAGE_COMMAND=/absolute/path/to/my-chatgpt-collector --json

# Optional advanced Claude collector. It must print the Claude endpoint schema in
# examples/claude-snapshot.example.json. If omitted, the local Claude Desktop
# cache supplies current weekly/session percentages only.
# CLAUDE_USAGE_COMMAND=/absolute/path/to/my-claude-collector --json

# Optional Telegram report. Keep real values only in .env (which Git ignores).
AI_USAGE_API_URL=http://127.0.0.1:8787
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
